	}
	
	metVelProbe
	{
		type				probes;
		libs            		("libsampling.so");
    		writeControl    adjustableRunTime;
    		writeInterval   500;

        	fields          		( U );

        	probeLocations
        	(
            		(-27.432 1.108456 0) // Quick estimate that met tower is ~90 ft in front of container
        	);
	}

