    maxLocalCells 100000;    // Limit the number of cells per processor
    maxGlobalCells 5000000;  // Limit the total number of cells
    minRefinementCells 10;   // Minimum number of cells to refine
    nCellsBetweenLevels 2;   // Smooth refinement between levels
	allowFreeStandingZoneFaces true;
    features
    (
	  {
            file "Flap.eMesh";
            level 2;
      	  }

	  {
            file "Building.eMesh";
            level 2;
      	  }
	  {
            file "Flap-Upper-Top.eMesh";
            level 2;
      	  }
	  {
            file "Flap-Lower-Top.eMesh";
            level 2;
      	  }
	  {
            file "Flap-Upper-Front.eMesh";
            level 2;
      	  }
	  {
            file "Flap-Lower-Front.eMesh";
            level 2;
      	  }
	  {
            file "Spoiler-Upper-Top.eMesh";
            level 2;
      	  }
	  {
            file "Spoiler-Lower-Top.eMesh";
            level 2;
      	  }
	  {
            file "Spoiler-Upper-Front.eMesh";
            level 2;
      	  }
	  {
            file "Spoiler-Lower-Front.eMesh";
            level 2;
      	  }

        );

    // Surface refinement
 
    refinementSurfaces
    {

    building
    {
        level (3 3);  // Minimum and maximum refinement levels
    }


    flap
    {
        level (5 5);  // Minimum and maximum refinement levels
    }
 
    flap_upper_top
    {
	level (5 5);  // Minimum and maximum refinement levels
    }

    flap_lower_top
    {
	level (5 5);  // Minimum and maximum refinement levels    
    }

    flap_upper_front
    {
	level (5 5);  // Minimum and maximum refinement levels    
	}

    flap_lower_front
    {
  	level (5 5);  // Minimum and maximum refinement levels    
	}


    spoiler_upper_top
    {
	level (5 5);  // Minimum and maximum refinement levels    
	}

    spoiler_upper_front
    {
	level (5 5);  // Minimum and maximum refinement levels    
	}

    spoiler_lower_top
    {
	level (5 5);  // Minimum and maximum refinement levels    
	}

    spoiler_lower_front
    {
	level (5 5);  // Minimum and maximum refinement levels    
	}

    }

    // Region refinement
    refinementRegions
    {
