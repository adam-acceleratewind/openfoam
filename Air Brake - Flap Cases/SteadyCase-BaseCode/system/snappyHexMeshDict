	mode distance;
	levels ((0.005 4) (0.1 3) (0.2 2));    
	}

    flap_lower_front
    {
	mode distance;
	levels ((0.005 4) (0.1 3) (0.2 2));    
	}


    spoiler_upper_top
    {
	mode distance;
	levels ((0.3 3) (1.5 2));    
	}

    spoiler_upper_front
    {
	mode distance;
	levels ((0.3 3) (1.5 2));    
	}

    spoiler_lower_top
    {
	mode distance;
