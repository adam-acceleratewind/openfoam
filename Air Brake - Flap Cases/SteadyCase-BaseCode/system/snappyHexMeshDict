FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;  // Enable castellated mesh generation
snap true;             // Enable snapping to STL surface
addLayers true;        // Enable inflation

// Geometry definition
geometry
{
    building
    {
        type triSurfaceMesh;
		file "Building.stl";
    }

    flap
    {
        type triSurfaceMesh;
		file "Flap.stl";
    }
 
    flap_upper_top
    {
        type triSurfaceMesh;
		file "Flap-Upper-Top.stl";
    }

    flap_lower_top
    {
        type triSurfaceMesh;
		file "Flap-Lower-Top.stl";
    }

    flap_upper_front
    {
        type triSurfaceMesh;
		file "Flap-Upper-Front.stl";
    }

    flap_lower_front
    {
        type triSurfaceMesh;
		file "Flap-Lower-Front.stl";
    }


    spoiler_upper_top
    {
        type triSurfaceMesh;
		file "Spoiler-Upper-Top.stl";
    }

    spoiler_upper_front
    {
        type triSurfaceMesh;
		file "Spoiler-Upper-Front.stl";
    }

    spoiler_lower_top
    {
        type triSurfaceMesh;
		file "Spoiler-Lower-Top.stl";
    }

    spoiler_lower_front
    {
        type triSurfaceMesh;
		file "Spoiler-Lower-Front.stl";
    }


	refinementBoxOuter
	{
		type box;
		// x-dimension is to start at incident recirculation zone
		// y-dimension is to start at ground
		min (-30 -15.24 0);
		// x-dimension is to cover cavity region
		// y-dimension is to cover rotor and an additional 1.5 m above
		max (100 7 .5);
	}
	
	refinementBoxInner
	{
		type box;
		// x-dimension is to start at incident recirculation zone
		// y-dimension is to start at ground
		min (-5 -5 0);
		// x-dimension is to cover cavity region
		// y-dimension is to cover rotor and an additional 1.5 m above
		max (7.5 5.5 .5);
	}

	
	refinementBoxSpoiler
	 {
	 	type searchableBox;
	 	min (-0.5 -1.6 0);
	 	max (2.5 0.8 .5);
	 }

	refinementBoxFlap
	 {
	 	type searchableBox;
	 	min (-0.125 .02 0);
	 	max (.035 0.185 .5);
	 }


}

