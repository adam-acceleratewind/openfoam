FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

                                                                          
numberOfSubdomains  100;

method      hierarchical;
coeffs
{
    //Break up the domain in x, y, and z chunks, this needs to equal the numberOfSubdomains
    n               (4 5 5); 
    order           xyz;
}


