// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale 1;  // Conversion factor, adjust if needed

// Domain and Building Dimensions
l_b         100.; 	// Container chord
w_b         253.32; 	// Container width
h_bMax      16.15; 	// Container max height
h_bMin	    14.32;	// Container min height

ridge_height  #calc "$h_bMax - $h_bMin";

// 5H recommended by Franke et al, 3H recommended by Abu-zidan et al
// Multiplier for domain upstream distance
l_u	15;
// 15H recommended by Franke et al, 3H recommended by Abu-zidan et al
// l_d         15.; // Multiplier for domain downstream distance
// 5H recommended by Franke et al, 3H recommended by Abu-zidan et al
// Multiplier for domain width distance, ignored in 2D (5 recommended by Franke et al
l_w	25;
// 6H recommended by Franke et al
// Multiplier for domain height distance, 33X is for blockage ratio of 3% in 2D
l_h	10;
// 0.3% recommended by Franke et al, 0.81% recommended by Abu-zidan et al

// Evaluation of Domain Dimensions
x_pad        #calc "$h_bMax * $l_u";
y_pad       #calc "$h_bMax * $l_h";
z_pad       #calc "$h_bMax * $l_w"; //Changed from w_b to h_b

// Evaluation of Vertex Positions
x0          #calc "-$x_pad";
x1          0;
x2          #calc "$l_b";

y0          #calc "-$h_bMin";
y1          0;
y2	    #calc "$y1 + $ridge_height";
y3          #calc "$y2 + $y_pad";

z0          #calc "-$w_b / 2 - $z_pad";
z1          #calc "-$w_b / 2";
z2	    0;
z3	    #calc "$z1 + $w_b";
z4	    #calc "$z3 + $z_pad";

//Normalizers to account for different sized domains to maintain consistency
normalx	    #calc "$l_u / 8";
normaly	    #calc "$l_h / 6";
normalz	    #calc "$l_w / 10";

nx1         #calc "$normalx * 150";  	 // Number of elements in the upstream direction
nx2         150;  	 // Number of elements from front of container to back of container
ny1         50;  	 // Number of elements from ground to container top
ny2         #calc "$normaly * 78";  	 // Number of elements from container top to domain top
nz1         #calc "$normalz * 80";  	 // Number of elements from container side to domain side
nz2         150;  	 // Number of elements along half of front edge of container
nz3         #calc "$normalz * 80";	 	 // Number of elements from container side to domain side

vertices
(
    ($x0 $y0 $z4)  // 0
