 	yPlus1
 	{
 		type            		yPlus;
 		libs 				(fieldFunctionObjects);
 		
 		enabled				true;
    		writeControl    adjustableRunTime;
    		writeInterval   .5;
 		
 		patches				(container spoiler ground);
 	}

  UpAvgTurbineVelOne
    {
    // Mandatory entries (unmodifiable)
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);

    // Mandatory entries (runtime modifiable)
    fields          (U);
    operation       areaAverage;
    regionType      faceZone;
    name            avgVel1Up;

    // Optional entries (runtime modifiable)
    postOperation   none;
    weightField     alpha1;
    scaleFactor     1.0;
    writeArea       false;
    surfaceFormat   none;

    // Optional (inherited) entries
    writeFields     false;
    scalingFactor   1.0;
    writePrecision  8;
    writeToFile     true;
    enabled         true;
    log             true;
    writeControl    adjustableRunTime;
    writeInterval   .005;
    }

