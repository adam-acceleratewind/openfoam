FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pimpleFoam;
startFrom       startTime;
// startFrom       latestTime;


libs
(
    "libturbinesFoam.so"
);

startTime       5000;
stopAt          endTime;
endTime         5005;

adjustTimeStep	yes;
maxCo		2;
maxDeltaT	.002;
//Calculated to be ~2 degrees each time step would be .001
deltaT          .001;

writeControl    adjustableRunTime;
writeInterval   .1;

purgeWrite      0;

writeFormat     ascii;
writePrecision  8;
writeCompression off;
writeResiduals	on;

timeFormat      general;
timePrecision   8;

runTimeModifiable true;


functions
{

	velProfiles
	{
		#include "sample"
	}
	
	turbVelProbe
	{
		type				probes;
		libs            		("libsampling.so");
    		writeControl    adjustableRunTime;
    		writeInterval   .005;

        	fields          		( U );

        	probeLocations
        	(
            		(0 1.108456 0)
        	);
	}

	turbSideVelProbe
	{
		type				probes;
